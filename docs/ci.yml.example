name: CI

on:
  push:
    branches: ["**"]
  pull_request:

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          # node:sqlite requires >= 22.5
          node-version: "22"
          cache: npm

      - name: Install
        run: npm ci

      - name: Typecheck
        run: npm run typecheck

      - name: Lint
        run: npm run lint

      - name: Security tests
        run: npm run test

      - name: Seed demo data
        run: npm run db:seed

      - name: Verify seeded data is coherent
        run: npx tsx scripts/check.ts

      - name: Build
        run: npm run build

      - name: Audit production dependencies
        run: npm audit --omit=dev
