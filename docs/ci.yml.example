name: CI

on:
  push:
    branches: ["**"]
  pull_request:

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          # node:sqlite requires >= 22.5
          node-version: "22"
          cache: npm

      - name: Install
        run: npm ci

      - name: Typecheck
        run: npm run typecheck

      - name: Lint
        run: npm run lint

      # All seven suites. They're fast (~10s total) and each one guards a
      # different boundary, so running only `npm run test` leaves most of the
      # app uncovered.
      - name: Security tests
        run: npm run test

      - name: Postgres data layer
        run: npm run test:pg

      - name: Email delivery
        run: npm run test:mail

      - name: Email verification
        run: npm run test:verify

      - name: Google Health integration
        run: npm run test:googlehealth

      - name: Webhook signature verification
        run: npm run test:webhook

      - name: Offline mode
        run: npm run test:offline

      - name: Seed demo data
        run: npm run db:seed

      - name: Verify seeded data is coherent
        run: npx tsx scripts/check.ts

      - name: Build
        run: npm run build

      - name: Audit production dependencies
        run: npm audit --omit=dev
