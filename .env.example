# Copy to `.env.local` for development, or set these in your host's dashboard.

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# Signs session cookies. The app refuses to boot in production without this,
# because the development fallback is public in this repo — anyone could
# forge a session with it.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
VESPER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# EMAIL  (password reset links)
# ---------------------------------------------------------------------------
# Without one of these, reset links are printed to the server console and
# shown in the dev UI. That's fine locally; real users need a transport.
#
# Option 1 — SMTP (works with Resend, SES, Postmark, Mailgun, Fastmail…)
# SMTP_URL=smtps://resend:re_xxxxx@smtp.resend.com:465
# SMTP_TLS_STRICT=true      # default false; some relays use mismatched certs
#
# Option 2 — Resend HTTP API (use when the host blocks outbound SMTP ports)
# RESEND_API_KEY=re_xxxxxxxx
#
# The From address. Must be a domain you've verified with your provider.
# MAIL_FROM=Vesper <no-reply@yourdomain.com>

# ---------------------------------------------------------------------------
# GOOGLE HEALTH API  (real biometric data from Fitbit / Pixel Watch)
# ---------------------------------------------------------------------------
# Without these, the Biometrics page uses locally simulated readings — the
# detection logic is real, the numbers aren't.
#
# NOTE: the legacy Fitbit Web API is closed to new apps and shuts down in
# September 2026. Fitbit data now comes through the Google Health API.
#
# Setup (see docs/TESTING.md for the click-through):
#   1. console.cloud.google.com -> new project
#   2. Enable "Google Health API"
#   3. Credentials -> OAuth client ID -> Web application
#      Authorized redirect URI:
#        http://localhost:3000/api/integrations/google-health/callback
#   4. Audience -> add your own Google account under "Test users"
#      (up to 100 test users without a security review)
#   5. Data Access -> add the googlehealth *.readonly scopes
#
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# GOOGLE_REDIRECT_URI=   # only if it differs from <origin>/api/integrations/google-health/callback

# Real-time push. Without a subscriber, data only arrives when the user presses
# "Pull today's data" — which undercuts the point of detecting spikes as they
# happen. Register a subscriber pointing at:
#   https://your-domain/api/integrations/google-health/webhook
# and set the same Authorization value here. Requires a public HTTPS URL, so
# use a tunnel (ngrok, cloudflared) for local testing.
# GOOGLE_HEALTH_WEBHOOK_TOKEN=Bearer some-long-random-string
#
# Dev only: skips webhook signature verification so you can POST test payloads
# by hand. Ignored when NODE_ENV=production.
# GOOGLE_HEALTH_SKIP_SIGNATURE=true

# Encrypts OAuth tokens at rest (AES-256-GCM). Required in production.
# Falls back to VESPER_AUTH_SECRET if unset.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# VESPER_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# Postgres connection string. When set, Vesper uses Postgres instead of
# SQLite — required for any real deployment.
# DATABASE_URL=postgres://user:pass@host:5432/vesper
# PGSSL=disable        # only for a local server without TLS
# PGPOOL_MAX=10        # connection pool size

# Where the SQLite file lives when DATABASE_URL is unset.
# VESPER_DB_PATH=./.data/vesper.db
# VESPER_DATA_DIR=./.data

# Route the companion's phrasing through an OpenAI-compatible model. Without
# a key the app uses its local reply composer, which needs no network.
# VESPER_LLM_API_KEY=
# VESPER_LLM_BASE_URL=https://api.openai.com/v1
# VESPER_LLM_MODEL=gpt-4o-mini
